# --- Google Places API (New) ---
# Console: https://console.cloud.google.com  -> enable "Places API (New)"
GOOGLE_PLACES_API_KEY=

# --- Notion ---
# Create an integration: https://www.notion.so/my-integrations
# Then share the parent page with that integration.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
# Filled in automatically by `outreach setup` — do not edit by hand.
NOTION_DB_PROJECTS=
NOTION_DB_LEADS=
NOTION_DB_TOUCHES=
NOTION_DB_APPOINTMENTS=
NOTION_DB_SUPPRESSION=

# --- Approval email (Gate A) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Outreach <outreach@tuodominio.it>"
MAIL_TO=difrancoantonio11@gmail.com

# --- Approval server ---
# Long random string. Generate with: openssl rand -hex 32
APPROVAL_SECRET=
APPROVAL_PORT=8787
# The URL the approval buttons point to. On the local network this can be
# http://localhost:8787 ; to click from your phone, put the Cloudflare Tunnel
# hostname here (see README).
PUBLIC_BASE_URL=http://localhost:8787
