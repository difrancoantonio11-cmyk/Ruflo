{
  "name": "@ruflo/outreach",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first outreach engine: finds businesses without a website, qualifies them, mirrors them into Notion and asks for approval by email.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "outreach": "node --env-file=.env --import tsx src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
